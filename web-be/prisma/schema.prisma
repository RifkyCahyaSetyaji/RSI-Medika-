  tanggalKirim   DateTime       @db.Timestamp(6)
  akun           akun           @relation(fields: [idAkun], references: [idAkun], onDelete: Cascade)
  pengajuan_cuti pengajuan_cuti @relation(fields: [idPengajuan], references: [idPengajuan], onDelete: Cascade)

  @@index([idAkun], map: "idx_notifikasi_akun")
  @@index([idPengajuan], map: "idx_notifikasi_pengajuan")
}

