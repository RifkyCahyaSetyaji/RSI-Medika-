generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model absensi {
  idAbsensi         String              @id @default(dbgenerated("('ABS'::text || lpad((nextval('seq_absensi'::regclass))::text, 9, '0'::text))")) @db.VarChar(12)
  idPegawai         String              @db.VarChar(10)
  idJadwal          String              @db.VarChar(10)
  tanggal           DateTime            @db.Date
  waktuMasuk        DateTime?           @db.Timestamp(6)
  waktuPulang       DateTime?           @db.Timestamp(6)
  statusKehadiran   String              @db.VarChar(20)
  statusPulang      String?             @db.VarChar(20)
  jadwal            jadwal              @relation(fields: [idJadwal], references: [idJadwal])
  pegawai           pegawai             @relation(fields: [idPegawai], references: [idPegawai])
  pengajuan_koreksi pengajuan_koreksi[]

  @@index([idJadwal], map: "idx_absensi_jadwal")
  @@index([idPegawai], map: "idx_absensi_pegawai")
  @@index([tanggal], map: "idx_absensi_tanggal")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model akun {
  idAkun     String       @id @default(dbgenerated("('AKN'::text || lpad((nextval('seq_akun'::regclass))::text, 7, '0'::text))")) @db.VarChar(10)
  idPegawai  String       @unique @db.VarChar(10)
  username   String       @unique @db.VarChar(50)
  password   String       @db.VarChar(255)
  role       String       @db.VarChar(30)
  pegawai    pegawai      @relation(fields: [idPegawai], references: [idPegawai], onDelete: Cascade)
  notifikasi notifikasi[]
}

