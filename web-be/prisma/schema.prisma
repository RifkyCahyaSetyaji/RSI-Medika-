}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model jadwal {
  idJadwal         String             @id @default(dbgenerated("('JDW'::text || lpad((nextval('seq_jadwal'::regclass))::text, 7, '0'::text))")) @db.VarChar(10)
  idPegawai        String             @db.VarChar(10)
  tanggal          DateTime           @db.Date
  jamMulai         DateTime           @db.Time(6)
  jamSelesai       DateTime           @db.Time(6)
  jenisJadwal      String             @db.VarChar(50)
  absensi          absensi[]
  pegawai          pegawai            @relation(fields: [idPegawai], references: [idPegawai])
  pengajuan_jadwal pengajuan_jadwal[]

  @@index([idPegawai], map: "idx_jadwal_pegawai")
  @@index([tanggal], map: "idx_jadwal_tanggal")
