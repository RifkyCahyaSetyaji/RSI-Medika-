{
  "name": "rsi-medika-be",
  "version": "1.0.0",
  "description": "Backend API RSI Medika (Express + Supabase)",
  "main": "src/server.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:schema": "node scripts/run-sql.js database/schema.sql",
    "db:seed": "node scripts/run-sql.js database/seed.sql",
    "db:setup": "node scripts/run-sql.js database/schema.sql database/seed.sql"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "pg": "^8.23.1"
  }
}
