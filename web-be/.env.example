NODE_ENV=development
PORT=3000

# Pisahkan dengan koma jika lebih dari satu, atau * untuk semua
CORS_ORIGIN=http://localhost:5173

# Supabase -> Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Koneksi Postgres langsung (untuk npm run db:*) - Supabase Dashboard > Connect > URI
DATABASE_URL=postgresql://postgres.your-project-ref:[PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres
