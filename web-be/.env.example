NODE_ENV=development
PORT=3000

# Pisahkan dengan koma jika lebih dari satu, atau * untuk semua
CORS_ORIGIN=http://localhost:5173

# JWT (buat secret acak panjang, mis. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=ganti-dengan-secret-acak-panjang
JWT_EXPIRES_IN=8h

# Supabase -> Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.your-project-ref:[PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.your-project-ref:[PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres"

# SMTP untuk mengirim email akun baru
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM="RSI Medika <your-email@example.com>"
# URL frontend (dipakai di link login pada email)
APP_URL=http://localhost:5173

# Zona waktu RS dalam menit dari UTC (WIB = 420)
APP_TZ_OFFSET_MINUTES=420
# Absensi: buka absen masuk X menit sebelum jadwal, toleransi terlambat, batas absen pulang setelah jadwal selesai
ABSEN_BUKA_MENIT=60
ABSEN_TOLERANSI_MENIT=0
ABSEN_BATAS_PULANG_MENIT=240
